{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://my-rahbar-production.up.railway.app/api/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://my-rahbar-production.up.railway.app/api/sitemap.xml"
    },
    {
      "source": "/sitemap-blogs.xml",
      "destination": "https://my-rahbar-production.up.railway.app/api/sitemap.xml/blogs"
    },
    {
      "source": "/sitemap-main.xml",
      "destination": "https://my-rahbar-production.up.railway.app/api/sitemap.xml/main"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://my-rahbar-production.up.railway.app/uploads/$1"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/seo"
    },
    {
      "source": "/university/:slug",
      "destination": "/api/seo"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
