{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "rahbars.com" }],
      "destination": "https://www.rahbars.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://my-rahbar-production-45d9.up.railway.app/api/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://my-rahbar-production-45d9.up.railway.app/api/sitemap.xml"
    },
    {
      "source": "/sitemap-blogs.xml",
      "destination": "https://my-rahbar-production-45d9.up.railway.app/api/sitemap.xml/blogs"
    },
    {
      "source": "/sitemap-main.xml",
      "destination": "https://my-rahbar-production-45d9.up.railway.app/api/sitemap.xml/main"
    },
    {
      "source": "/sitemap-universities.xml",
      "destination": "https://my-rahbar-production-45d9.up.railway.app/api/sitemap.xml/universities"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://my-rahbar-production-45d9.up.railway.app/uploads/$1"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
